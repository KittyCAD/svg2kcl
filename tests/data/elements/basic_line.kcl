sketch001 = sketch(on = XY) {
  seg001 = line(start = [var 0, var 0], end = [var 80, var -80])
  fixed([seg001.start, [0, 0]])
  fixed([seg001.end, [80, -80]])
}

sketch002 = sketch(on = XY) {
  seg001 = line(start = [var 20, var -80], end = [var 100, var 0])
  fixed([seg001.start, [20, -80]])
  fixed([seg001.end, [100, 0]])
}