sketch001 = sketch(on = XY) {
  seg001 = line(start = [var 50, var -10], end = [var 90, var -90])
  distance([seg001.start, seg001.end]) == 89.443
  seg002 = line(start = [var 90, var -90], end = [var 10, var -90])
  horizontal(seg002)
  distance([seg002.start, seg002.end]) == 80
  coincident([seg001.end, seg002.start])
  seg003 = line(start = [var 10, var -90], end = [var 50, var -10])
  distance([seg003.start, seg003.end]) == 89.443
  coincident([seg002.end, seg003.start])
  coincident([seg003.end, seg001.start])
  seg004 = line(start = [var 20, var -20], end = [var 80, var -20])
  horizontal(seg004)
  distance([seg004.start, seg004.end]) == 60
  seg005 = line(start = [var 80, var -20], end = [var 80, var -80])
  vertical(seg005)
  distance([seg005.start, seg005.end]) == 60
  coincident([seg004.end, seg005.start])
  seg006 = line(start = [var 80, var -80], end = [var 20, var -80])
  horizontal(seg006)
  distance([seg006.start, seg006.end]) == 60
  coincident([seg005.end, seg006.start])
  seg007 = line(start = [var 20, var -80], end = [var 20, var -20])
  vertical(seg007)
  distance([seg007.start, seg007.end]) == 60
  coincident([seg006.end, seg007.start])
  coincident([seg007.end, seg004.start])
}

region001 = region(point = [69.8, -50.133], sketch = sketch001)

region002 = region(point = [50, -20.3], sketch = sketch001)