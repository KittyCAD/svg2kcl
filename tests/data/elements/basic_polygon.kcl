sketch001 = sketch(on = XY) {
  seg001 = line(start = [var 50, var -10], end = [var 90, var -90])
  fixed([seg001.start, [50, -10]])
  fixed([seg001.end, [90, -90]])
  seg002 = line(start = [var 90, var -90], end = [var 10, var -90])
  fixed([seg002.start, [90, -90]])
  fixed([seg002.end, [10, -90]])
  coincident([seg001.end, seg002.start])
  seg003 = line(start = [var 10, var -90], end = [var 50, var -10])
  fixed([seg003.start, [10, -90]])
  fixed([seg003.end, [50, -10]])
  coincident([seg002.end, seg003.start])
  coincident([seg003.end, seg001.start])
}

sketch002 = sketch(on = XY) {
  seg001 = line(start = [var 20, var -20], end = [var 80, var -20])
  fixed([seg001.start, [20, -20]])
  fixed([seg001.end, [80, -20]])
  seg002 = line(start = [var 80, var -20], end = [var 80, var -80])
  fixed([seg002.start, [80, -20]])
  fixed([seg002.end, [80, -80]])
  coincident([seg001.end, seg002.start])
  seg003 = line(start = [var 80, var -80], end = [var 20, var -80])
  fixed([seg003.start, [80, -80]])
  fixed([seg003.end, [20, -80]])
  coincident([seg002.end, seg003.start])
  seg004 = line(start = [var 20, var -80], end = [var 20, var -20])
  fixed([seg004.start, [20, -80]])
  fixed([seg004.end, [20, -20]])
  coincident([seg003.end, seg004.start])
  coincident([seg004.end, seg001.start])
}