sketch001 = sketch(on = XY) {
  seg001 = line(start = [var 10, var -10], end = [var 30, var -90])
  fixed([seg001.start, [10, -10]])
  fixed([seg001.end, [30, -90]])
  seg002 = line(start = [var 30, var -90], end = [var 50, var -10])
  fixed([seg002.start, [30, -90]])
  fixed([seg002.end, [50, -10]])
  coincident([seg001.end, seg002.start])
  seg003 = line(start = [var 50, var -10], end = [var 70, var -90])
  fixed([seg003.start, [50, -10]])
  fixed([seg003.end, [70, -90]])
  coincident([seg002.end, seg003.start])
  seg004 = line(start = [var 70, var -90], end = [var 90, var -10])
  fixed([seg004.start, [70, -90]])
  fixed([seg004.end, [90, -10]])
  coincident([seg003.end, seg004.start])
}

sketch002 = sketch(on = XY) {
  seg001 = line(start = [var 10, var -50], end = [var 30, var -30])
  fixed([seg001.start, [10, -50]])
  fixed([seg001.end, [30, -30]])
  seg002 = line(start = [var 30, var -30], end = [var 50, var -50])
  fixed([seg002.start, [30, -30]])
  fixed([seg002.end, [50, -50]])
  coincident([seg001.end, seg002.start])
  seg003 = line(start = [var 50, var -50], end = [var 70, var -30])
  fixed([seg003.start, [50, -50]])
  fixed([seg003.end, [70, -30]])
  coincident([seg002.end, seg003.start])
  seg004 = line(start = [var 70, var -30], end = [var 90, var -50])
  fixed([seg004.start, [70, -30]])
  fixed([seg004.end, [90, -50]])
  coincident([seg003.end, seg004.start])
}