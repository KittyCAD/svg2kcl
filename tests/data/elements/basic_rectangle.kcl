sketch001 = sketch(on = XY) {
  seg001 = line(start = [var 10, var -10], end = [var 90, var -10])
  fixed([seg001.start, [10, -10]])
  fixed([seg001.end, [90, -10]])
  seg002 = line(start = [var 90, var -10], end = [var 90, var -50])
  fixed([seg002.start, [90, -10]])
  fixed([seg002.end, [90, -50]])
  coincident([seg001.end, seg002.start])
  seg003 = line(start = [var 90, var -50], end = [var 10, var -50])
  fixed([seg003.start, [90, -50]])
  fixed([seg003.end, [10, -50]])
  coincident([seg002.end, seg003.start])
  seg004 = line(start = [var 10, var -50], end = [var 10, var -10])
  fixed([seg004.start, [10, -50]])
  fixed([seg004.end, [10, -10]])
  coincident([seg003.end, seg004.start])
  coincident([seg004.end, seg001.start])
}

sketch002 = sketch(on = XY) {
  seg001 = line(start = [var 30, var -60], end = [var 70, var -60])
  fixed([seg001.start, [30, -60]])
  fixed([seg001.end, [70, -60]])
  seg002 = arc(start = [var 80, var -70], end = [var 70, var -60], center = [var 70, var -70])
  fixed([seg002.start, [80, -70]])
  fixed([seg002.end, [70, -60]])
  fixed([seg002.center, [70, -70]])
  coincident([seg001.end, seg002.end])
  seg003 = line(start = [var 80, var -70], end = [var 80, var -80])
  fixed([seg003.start, [80, -70]])
  fixed([seg003.end, [80, -80]])
  coincident([seg002.start, seg003.start])
  seg004 = arc(start = [var 70, var -90], end = [var 80, var -80], center = [var 70, var -80])
  fixed([seg004.start, [70, -90]])
  fixed([seg004.end, [80, -80]])
  fixed([seg004.center, [70, -80]])
  coincident([seg003.end, seg004.end])
  seg005 = line(start = [var 70, var -90], end = [var 30, var -90])
  fixed([seg005.start, [70, -90]])
  fixed([seg005.end, [30, -90]])
  coincident([seg004.start, seg005.start])
  seg006 = arc(start = [var 20, var -80], end = [var 30, var -90], center = [var 30, var -80])
  fixed([seg006.start, [20, -80]])
  fixed([seg006.end, [30, -90]])
  fixed([seg006.center, [30, -80]])
  coincident([seg005.end, seg006.end])
  seg007 = line(start = [var 20, var -80], end = [var 20, var -70])
  fixed([seg007.start, [20, -80]])
  fixed([seg007.end, [20, -70]])
  coincident([seg006.start, seg007.start])
  seg008 = arc(start = [var 30, var -60], end = [var 20, var -70], center = [var 30, var -70])
  fixed([seg008.start, [30, -60]])
  fixed([seg008.end, [20, -70]])
  fixed([seg008.center, [30, -70]])
  coincident([seg007.end, seg008.end])
  coincident([seg008.start, seg001.start])
}