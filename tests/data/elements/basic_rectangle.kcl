sketch001 = sketch(on = XY) {
  seg001 = line(start = [var 10, var -10], end = [var 90, var -10])
  horizontal(seg001)
  distance([seg001.start, seg001.end]) == 80
  seg002 = line(start = [var 90, var -10], end = [var 90, var -50])
  vertical(seg002)
  distance([seg002.start, seg002.end]) == 40
  coincident([seg001.end, seg002.start])
  seg003 = line(start = [var 90, var -50], end = [var 10, var -50])
  horizontal(seg003)
  distance([seg003.start, seg003.end]) == 80
  coincident([seg002.end, seg003.start])
  seg004 = line(start = [var 10, var -50], end = [var 10, var -10])
  vertical(seg004)
  distance([seg004.start, seg004.end]) == 40
  coincident([seg003.end, seg004.start])
  coincident([seg004.end, seg001.start])
  seg005 = line(start = [var 30, var -60], end = [var 70, var -60])
  horizontal(seg005)
  distance([seg005.start, seg005.end]) == 40
  seg006 = arc(start = [var 80, var -70], end = [var 70, var -60], center = [var 70, var -70])
  radius(seg006) == 10
  coincident([seg005.end, seg006.end])
  tangent([seg005, seg006])
  seg007 = line(start = [var 80, var -70], end = [var 80, var -80])
  vertical(seg007)
  distance([seg007.start, seg007.end]) == 10
  coincident([seg006.start, seg007.start])
  tangent([seg006, seg007])
  seg008 = arc(start = [var 70, var -90], end = [var 80, var -80], center = [var 70, var -80])
  radius(seg008) == 10
  coincident([seg007.end, seg008.end])
  tangent([seg007, seg008])
  seg009 = line(start = [var 70, var -90], end = [var 30, var -90])
  horizontal(seg009)
  distance([seg009.start, seg009.end]) == 40
  coincident([seg008.start, seg009.start])
  tangent([seg008, seg009])
  seg010 = arc(start = [var 20, var -80], end = [var 30, var -90], center = [var 30, var -80])
  radius(seg010) == 10
  coincident([seg009.end, seg010.end])
  tangent([seg009, seg010])
  seg011 = line(start = [var 20, var -80], end = [var 20, var -70])
  vertical(seg011)
  distance([seg011.start, seg011.end]) == 10
  coincident([seg010.start, seg011.start])
  tangent([seg010, seg011])
  seg012 = arc(start = [var 30, var -60], end = [var 20, var -70], center = [var 30, var -70])
  radius(seg012) == 10
  coincident([seg011.end, seg012.end])
  tangent([seg011, seg012])
  coincident([seg012.start, seg005.start])
  tangent([seg012, seg005])
}

region001 = region(point = [50, -10.2], sketch = sketch001)

region002 = region(point = [50, -60.15], sketch = sketch001)