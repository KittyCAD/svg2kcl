@settings(experimentalFeatures = allow)

sketch001 = sketch(on = XY) {
  seg001 = line(start = [var 10, var -10], end = [var 90, var -10])
  fixed([seg001.start, [10, -10]])
  fixed([seg001.end, [90, -10]])
  seg002 = line(start = [var 90, var -10], end = [var 90, var -30])
  fixed([seg002.start, [90, -10]])
  fixed([seg002.end, [90, -30]])
  coincident([seg001.end, seg002.start])
  seg003 = line(start = [var 90, var -30], end = [var 10, var -30])
  fixed([seg003.start, [90, -30]])
  fixed([seg003.end, [10, -30]])
  coincident([seg002.end, seg003.start])
  seg004 = line(start = [var 10, var -30], end = [var 10, var -10])
  fixed([seg004.start, [10, -30]])
  fixed([seg004.end, [10, -10]])
  coincident([seg003.end, seg004.start])
  coincident([seg004.end, seg001.start])
}

sketch002 = sketch(on = XY) {
  seg001 = circle(start = [var 65, var -50], center = [var 50, var -50])
  fixed([seg001.center, [50, -50]])
  fixed([seg001.start, [65, -50]])
  horizontal([seg001.center, seg001.start])
}

sketch003 = sketch(on = XY) {
  seg001 = line(start = [var 10, var -70], end = [var 90, var -70])
  fixed([seg001.start, [10, -70]])
  fixed([seg001.end, [90, -70]])
}

sketch004 = sketch(on = XY) {
  seg001 = line(start = [var 20, var -80], end = [var 50, var -80])
  fixed([seg001.start, [20, -80]])
  fixed([seg001.end, [50, -80]])
  seg002 = controlPointSpline(points = [
    [50, -80],
    [40, -86.667],
    [30, -86.667],
    [20, -80]
  ])
  seg003 = controlPointSpline(points = [
    [50, -80],
    [60, -73.333],
    [70, -73.333],
    [80, -80]
  ])
  seg004 = line(start = [var 80, var -80], end = [var 50, var -80])
  fixed([seg004.start, [80, -80]])
  fixed([seg004.end, [50, -80]])
}

sketch005 = sketch(on = XY) {
  seg001 = line(start = [var 10, var -90], end = [var 50, var -95])
  fixed([seg001.start, [10, -90]])
  fixed([seg001.end, [50, -95]])
  seg002 = line(start = [var 50, var -95], end = [var 90, var -90])
  fixed([seg002.start, [50, -95]])
  fixed([seg002.end, [90, -90]])
  coincident([seg001.end, seg002.start])
  seg003 = line(start = [var 90, var -90], end = [var 10, var -90])
  fixed([seg003.start, [90, -90]])
  fixed([seg003.end, [10, -90]])
  coincident([seg002.end, seg003.start])
  coincident([seg003.end, seg001.start])
}