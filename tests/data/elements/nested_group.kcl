sketch001 = sketch(on = XY) {
  seg001 = line(start = [var 10, var -10], end = [var 40, var -10])
  horizontal(seg001)
  distance([seg001.start, seg001.end]) == 30
  seg002 = line(start = [var 40, var -10], end = [var 40, var -40])
  vertical(seg002)
  distance([seg002.start, seg002.end]) == 30
  coincident([seg001.end, seg002.start])
  seg003 = line(start = [var 40, var -40], end = [var 10, var -40])
  horizontal(seg003)
  distance([seg003.start, seg003.end]) == 30
  coincident([seg002.end, seg003.start])
  seg004 = line(start = [var 10, var -40], end = [var 10, var -10])
  vertical(seg004)
  distance([seg004.start, seg004.end]) == 30
  coincident([seg003.end, seg004.start])
  coincident([seg004.end, seg001.start])
  seg005 = circle(start = [var 85, var -25], center = [var 70, var -25])
  horizontal([seg005.center, seg005.start])
  diameter(seg005) == 30
  seg006 = line(start = [var 10, var -50], end = [var 90, var -50])
  horizontal(seg006)
  distance([seg006.start, seg006.end]) == 80
  seg007 = line(start = [var 10, var -70], end = [var 50, var -90])
  distance([seg007.start, seg007.end]) == 44.721
  seg008 = line(start = [var 50, var -90], end = [var 90, var -70])
  distance([seg008.start, seg008.end]) == 44.721
  coincident([seg007.end, seg008.start])
}

region001 = region(point = [25, -10.15], sketch = sketch001)

region002 = region(point = [70, -25], sketch = sketch001)