@settings(experimentalFeatures = allow)

sketch001 = sketch(on = XY) {
  seg001 = controlPointSpline(points = [
    [var 10, var -50],
    [var 20, var -20],
    [var 40, var -20],
    [var 50, var -50]
  ])
  seg002 = line(start = [var 50, var -50], end = [var 10, var -50])
  horizontal(seg002)
  distance([seg002.start, seg002.end]) == 40
  seg003 = line(start = [var 50, var -50], end = [var 90, var -50])
  horizontal(seg003)
  distance([seg003.start, seg003.end]) == 40
  seg004 = controlPointSpline(points = [
    [var 90, var -50],
    [var 80, var -80],
    [var 60, var -80],
    [var 50, var -50]
  ])
}