sketch001 = sketch(on = XY) {
  seg001 = line(start = [var 0, var 0], end = [var 50, var -50])
  distance([seg001.start, seg001.end]) == 70.711
  seg002 = line(start = [var 50, var -50], end = [var 0, var -100])
  distance([seg002.start, seg002.end]) == 70.711
  coincident([seg001.end, seg002.start])
  seg003 = line(start = [var 0, var -100], end = [var 0, var 0])
  vertical(seg003)
  distance([seg003.start, seg003.end]) == 100
  coincident([seg002.end, seg003.start])
  coincident([seg003.end, seg001.start])
  seg004 = line(start = [var 50, var -50], end = [var 100, var 0])
  distance([seg004.start, seg004.end]) == 70.711
  seg005 = line(start = [var 100, var 0], end = [var 100, var -100])
  vertical(seg005)
  distance([seg005.start, seg005.end]) == 100
  coincident([seg004.end, seg005.start])
  seg006 = line(start = [var 100, var -100], end = [var 50, var -50])
  distance([seg006.start, seg006.end]) == 70.711
  coincident([seg005.end, seg006.start])
  coincident([seg006.end, seg004.start])
}

region001 = region(point = [24.917, -25.25], sketch = sketch001)

region002 = region(point = [75.083, -25.25], sketch = sketch001)