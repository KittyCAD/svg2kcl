@settings(experimentalFeatures = allow)

sketch001 = sketch(on = XY) {
  seg001 = line(start = [var 10, var -10], end = [var 90, var -10])
  horizontal(seg001)
  distance([seg001.start, seg001.end]) == 80
  seg002 = line(start = [var 90, var -10], end = [var 90, var -90])
  vertical(seg002)
  distance([seg002.start, seg002.end]) == 80
  coincident([seg001.end, seg002.start])
  seg003 = line(start = [var 90, var -90], end = [var 10, var -90])
  horizontal(seg003)
  distance([seg003.start, seg003.end]) == 80
  coincident([seg002.end, seg003.start])
  seg004 = line(start = [var 10, var -90], end = [var 10, var -10])
  vertical(seg004)
  distance([seg004.start, seg004.end]) == 80
  coincident([seg003.end, seg004.start])
  coincident([seg004.end, seg001.start])
  seg005 = line(start = [var 60, var -60], end = [var 70, var -60])
  horizontal(seg005)
  distance([seg005.start, seg005.end]) == 10
  seg006 = line(start = [var 70, var -60], end = [var 70, var -63.333])
  vertical(seg006)
  distance([seg006.start, seg006.end]) == 3.333
  coincident([seg005.end, seg006.start])
  seg007 = controlPointSpline(points = [
    [var 70, var -63.333],
    [var 67.052, var -65.299],
    [var 64.104, var -65.526],
    [var 61.156, var -64.015]
  ])
  seg008 = arc(start = [var 60, var -60], end = [var 61.156, var -64.015], center = [var 114.149, var -46.463])
  radius(seg008) == 55.825
  coincident([seg008.start, seg005.start])
  seg009 = line(start = [var 63.745, var -70], end = [var 70, var -70])
  horizontal(seg009)
  distance([seg009.start, seg009.end]) == 6.255
  seg010 = line(start = [var 70, var -70], end = [var 70, var -63.333])
  vertical(seg010)
  distance([seg010.start, seg010.end]) == 6.667
  coincident([seg009.end, seg010.start])
  seg011 = arc(start = [var 70, var -63.333], end = [var 73.66, var -60], center = [var 59.743, var -47.948])
  radius(seg011) == 18.491
  coincident([seg010.end, seg011.start])
  seg012 = line(start = [var 73.66, var -60], end = [var 80, var -60])
  distance([seg012.start, seg012.end]) == 6.34
  coincident([seg011.end, seg012.start])
  seg013 = controlPointSpline(points = [
    [var 80, var -60],
    [var 76.057, var -75.773],
    [var 69.003, var -79.107],
    [var 63.745, var -70]
  ])
  seg014 = line(start = [var 70, var -50], end = [var 80, var -50])
  horizontal(seg014)
  distance([seg014.start, seg014.end]) == 10
  seg015 = arc(start = [var 73.66, var -60], end = [var 80, var -50], center = [var 37.68, var -28.84])
  radius(seg015) == 47.316
  coincident([seg014.end, seg015.end])
  seg016 = line(start = [var 73.66, var -60], end = [var 70, var -60])
  distance([seg016.start, seg016.end]) == 3.66
  coincident([seg015.start, seg016.start])
  seg017 = line(start = [var 70, var -60], end = [var 70, var -50])
  vertical(seg017)
  distance([seg017.start, seg017.end]) == 10
  coincident([seg016.end, seg017.start])
  coincident([seg017.end, seg014.start])
}

region001 = region(point = [50, -10.4], sketch = sketch001)

region002 = region(point = [74.987, -50.042], sketch = sketch001)