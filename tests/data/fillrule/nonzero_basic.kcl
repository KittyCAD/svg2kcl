sketch001 = sketch(on = XY) {
  seg001 = line(start = [var 50, var -50], end = [var 250, var -50])
  horizontal(seg001)
  distance([seg001.start, seg001.end]) == 200
  seg002 = line(start = [var 250, var -50], end = [var 250, var -250])
  vertical(seg002)
  distance([seg002.start, seg002.end]) == 200
  coincident([seg001.end, seg002.start])
  seg003 = line(start = [var 250, var -250], end = [var 50, var -250])
  horizontal(seg003)
  distance([seg003.start, seg003.end]) == 200
  coincident([seg002.end, seg003.start])
  seg004 = line(start = [var 50, var -250], end = [var 50, var -50])
  vertical(seg004)
  distance([seg004.start, seg004.end]) == 200
  coincident([seg003.end, seg004.start])
  coincident([seg004.end, seg001.start])
  seg005 = line(start = [var 100, var -100], end = [var 200, var -100])
  horizontal(seg005)
  distance([seg005.start, seg005.end]) == 100
  seg006 = line(start = [var 200, var -100], end = [var 200, var -200])
  vertical(seg006)
  distance([seg006.start, seg006.end]) == 100
  coincident([seg005.end, seg006.start])
  seg007 = line(start = [var 200, var -200], end = [var 100, var -200])
  horizontal(seg007)
  distance([seg007.start, seg007.end]) == 100
  coincident([seg006.end, seg007.start])
  seg008 = line(start = [var 100, var -200], end = [var 100, var -100])
  vertical(seg008)
  distance([seg008.start, seg008.end]) == 100
  coincident([seg007.end, seg008.start])
  coincident([seg008.end, seg005.start])
}

region001 = region(point = [150, -51], sketch = sketch001)

region002 = region(point = [150, -100.5], sketch = sketch001)