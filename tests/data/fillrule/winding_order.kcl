sketch001 = sketch(on = XY) {
  seg001 = line(start = [var 10, var -5], end = [var 110, var -15])
  fixed([seg001.start, [10, -5]])
  fixed([seg001.end, [110, -15]])
  seg002 = line(start = [var 110, var -15], end = [var 60, var -65])
  fixed([seg002.start, [110, -15]])
  fixed([seg002.end, [60, -65]])
  coincident([seg001.end, seg002.start])
  seg003 = line(start = [var 60, var -65], end = [var 110, var -115])
  fixed([seg003.start, [60, -65]])
  fixed([seg003.end, [110, -115]])
  coincident([seg002.end, seg003.start])
  seg004 = line(start = [var 110, var -115], end = [var 10, var -125])
  fixed([seg004.start, [110, -115]])
  fixed([seg004.end, [10, -125]])
  coincident([seg003.end, seg004.start])
  seg005 = line(start = [var 10, var -125], end = [var 10, var -5])
  fixed([seg005.start, [10, -125]])
  fixed([seg005.end, [10, -5]])
  coincident([seg004.end, seg005.start])
  coincident([seg005.end, seg001.start])
}

